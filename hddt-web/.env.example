# ── Cấu hình môi trường HDDT Checker Web ───────────────────
# Copy file này thành .env rồi chỉnh sửa. Dùng được cho cả 2 cách chạy:
#   - Docker: nạp qua docker-compose.yml lúc "docker compose up -d"
#   - Windows chạy trực tiếp (không Docker): app tự đọc file .env này
#     (xem config.py, dùng python-dotenv) — không cần set biến môi trường tay.

# Flask secret key — ĐỔI NGAY trước khi dùng thật! Tạo key ngẫu nhiên bằng:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=doi-key-nay-truoc-khi-dung-that

# Port máy chủ (host) map vào container — mặc định 14687.
PORT=14687

# Thư mục dữ liệu (bind mount vào container tại /data): DB, Excel, ảnh, log.
# Mặc định ./data ngay cạnh docker-compose.yml.
# NAS Synology: nên đặt trong volume ổ lớn, ví dụ:
# DATA_PATH=/volume1/docker/hddt-web/data
DATA_PATH=./data

# Giới hạn RAM container — quan trọng nếu máy chạy chung nhiều dịch vụ khác
# (Pi4/NAS ít RAM trống). Tăng lên nếu máy dư RAM, ví dụ 1g.
MEM_LIMIT=768m

# Số job chạy đồng thời tối đa (nên để 1 nếu máy yếu — Chromium khá tốn RAM).
MAX_CONCURRENT_JOBS=1

# Captcha
MAX_CAPTCHA_AUTO=5
PAGE_WAIT=2.5

TZ=Asia/Ho_Chi_Minh

# Bản quyền hiển thị ở footer web.
COPYRIGHT_OWNER=Nguyễn Xuân Bình

# Telegram (tùy chọn) — thông báo khi đăng nhập + khi kiểm tra xong. Để trống
# 1 trong 2 biến dưới = tắt hoàn toàn, không lỗi gì.
# Tạo bot: nhắn @BotFather trên Telegram -> /newbot -> lấy token.
# Lấy chat_id: thêm bot vào group/kênh rồi gọi
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
